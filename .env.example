# Nuxt Studio — the content editor at /_studio
#
# Studio signs you in with a GitHub OAuth app so it can commit your edits back
# to the repository. Create one at:
#
#   https://github.com/settings/developers  →  New OAuth App
#
#     Application name          Job Seekers Guide Studio
#     Homepage URL              http://localhost:4321
#     Authorization callback    http://localhost:4321/__nuxt_studio/auth/github
#
# Copy this file to `.env` (which is gitignored) and paste the two values in.
# The secret must never be committed.
#
# Note the variable names: they are STUDIO_*, not NUXT_STUDIO_AUTH_* as some
# docs pages state. These are the names the module actually reads.
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
