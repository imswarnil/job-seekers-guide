{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jsg-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "observability": {
    "enabled": true
  },
  // Holds both the result cache and the per-IP rate counters. Create it with:
  //   npx wrangler kv namespace create RUNNER_CACHE
  // then paste the id here.
  "kv_namespaces": [
    {
      "binding": "RUNNER_CACHE",
      "id": "1b11e4f90b314bf794dd05bfecb12f16"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jobseekers.imswarnil.com,http://localhost:3000,http://localhost:4801"
  }
  // PISTON_URL and PISTON_TOKEN are secrets, set with:
  //   npx wrangler secret put PISTON_TOKEN
  // Leave them unset to use the free public Piston instance.
}
