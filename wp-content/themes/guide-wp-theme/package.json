{
  "name": "guide-wp-theme",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:theme && npm run build:admin && npm run build:skin",
    "watch": "sass --watch --load-path=node_modules src/scss/app.scss assets/css/app.min.css",
    "icons": "node tools/build-icons.mjs",
    "build:theme": "sass --no-source-map --style=compressed --load-path=node_modules src/scss/app.scss assets/css/app.min.css",
    "build:admin": "sass --no-source-map --style=compressed --load-path=node_modules src/scss/admin.scss .tmp/console.css && postcss .tmp/console.css -o ../../plugins/guide-lms/admin/assets/css/console.min.css --no-map",
    "build:skin": "sass --no-source-map --style=compressed --load-path=node_modules src/scss/admin-skin.scss ../../plugins/guide-lms/admin/assets/css/admin-skin.min.css && sass --no-source-map --style=compressed --load-path=node_modules src/scss/login.scss ../../plugins/guide-lms/admin/assets/css/login.min.css"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "bulma": "^1.0.4",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-prefix-selector": "^2.1.1",
    "sass": "^1.102.0"
  },
  "private": true
}
